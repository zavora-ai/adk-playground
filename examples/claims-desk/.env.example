# Claude: the agent and the damage assessor. Without it, `run` and `serve` replay the recorded
# answers in recordings/.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: your contact for Wikimedia, which asks automated clients to name themselves.
# WIKIMEDIA_USER_AGENT=claims-desk/0.1 (you@example.com)
# Optional: where model weights are cached (RF-DETR Nano, SAM 2.1 Tiny, SigLIP 2).
# HF_HUB_CACHE=/path/to/models
