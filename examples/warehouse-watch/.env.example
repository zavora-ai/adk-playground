# Claude: the agent, the vehicle spotter and the clip review. Without it, `run` and `serve`
# replay the recorded answers in recordings/.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: where model weights are cached (RF-DETR Nano).
# HF_HUB_CACHE=/path/to/models
# Optional: the ffmpeg binary, when it is not on the PATH.
# ADK_VISION_FFMPEG=/opt/homebrew/bin/ffmpeg
